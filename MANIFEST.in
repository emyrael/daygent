# Public source distribution only. Private docs/, Graphify output, and
# local scan artifacts must never enter the sdist.
include LICENSE
include README.md
include CONTRIBUTING.md
include pyproject.toml
graft src/daygent
graft tests
graft .github
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.egg-info
# Scan output lands in a .daygent/ beside whatever was scanned, so exclude it
# by pattern rather than naming each fixture; a new fixture must not leak.
global-exclude .daygent/*
recursive-exclude . .daygent
prune docs
prune graphify-out
prune .daygent
prune src/daygent.egg-info
prune .cursor
prune .scratch
prune .venv
prune venv
prune dist
prune build
prune .pytest_cache
